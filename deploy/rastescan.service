[Unit]
Description=RasteScan API
After=network-online.target

[Service]
User=rastescan
WorkingDirectory=/opt/rastescan/backend
EnvironmentFile=/etc/rastescan.env
ExecStart=/opt/rastescan/backend/.venv/bin/uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
