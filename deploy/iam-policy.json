{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNova",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:*:*:inference-profile/*amazon.nova-*"
      ]
    },
    {
      "Sid": "Photos",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME/photos/*"
    }
  ]
}
