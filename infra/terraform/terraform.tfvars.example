# Copy to terraform.tfvars (git-ignored) and fill in.
ssh_allowed_cidr = "203.0.113.7/32"   # your IP: curl -s https://checkip.amazonaws.com
budget_email     = "team@example.com"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# bedrock_model_id    = "apac.amazon.nova-lite-v1:0"

# If your AWS Organization blocks ap-south-1 (error mentions a "service control policy"), use Stockholm:
# region           = "eu-north-1"
# bedrock_model_id = "eu.amazon.nova-pro-v1:0"
# If Bedrock is only unlocked in another region (new accounts: "Operation not allowed" elsewhere), keep the server
# where it is and call Bedrock there. Test first with: aws bedrock-runtime converse --region us-west-2 ...
# bedrock_region   = "us-west-2"
# bedrock_model_id = "us.amazon.nova-lite-v1:0"
# create_budget    = false   # only if the Budgets API is also blocked
