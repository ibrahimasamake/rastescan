# Copy to /etc/rastescan.env on the server (see docs/aws-setup.md).
AI_MODE=bedrock                       # use "fake" only for local UI work; the app shows a "Test mode" banner
AWS_REGION=ap-south-1                 # Mumbai
BEDROCK_REGION=ap-south-1                # only if Bedrock works in a different region than AWS_REGION
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0   # or apac.amazon.nova-lite-v1:0; must be enabled in Bedrock
# AI_MODE=groq   (free key from console.groq.com; photos are blurred before they leave the server)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_MODE=ollama (local; run `ollama pull qwen2.5vl:7b` first)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl:7b
S3_BUCKET=                            # empty = store photos on the server disk
DASHBOARD_PIN=change-me               # needed to change tickets on the ward dashboard
DATA_DIR=/var/lib/rastescan
MAX_UPLOAD_MB=8
REPORTS_PER_HOUR=30
