# Copy to /etc/rastescan.env on the server (Ansible writes it for you), or export these locally.
# Never commit real values.

# AI provider: bedrock (Amazon Nova), groq (free key), ollama (local), or fake (test mode, shows a banner)
AI_MODE=bedrock
BEDROCK_REGION=ap-south-1                # only if Bedrock works in a different region than AWS_REGION
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Portal
SITE_NAME=Municipal Road Services       # generic name; never use a real government's name or emblem
PUBLIC_BASE_URL=                        # e.g. https://d1234abcd.cloudfront.net, used in emails and CSV links
TIMEZONE=Asia/Kolkata
WARDS_FILE=                             # defaults to data/wards.geojson (sample wards)

# Officer accounts: the first admin is created from these on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=                         # at least 10 characters
ADMIN_NAME=Administrator
SECRET_KEY=                             # empty = generated once into DATA_DIR/secret.key
DASHBOARD_PIN=                          # optional shared PIN fallback for the expo; empty disables it

# Optional email to citizens who leave an address
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

S3_BUCKET=                              # empty = store photos on the server disk
DATA_DIR=/var/lib/rastescan
MAX_UPLOAD_MB=8
REPORTS_PER_HOUR=30
